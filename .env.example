# SoundCloud Artist Pro → register an app
# https://developers.soundcloud.com/docs/api/register-app
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# AudD token from https://dashboard.audd.io/
# Full sets need a plan that includes the enterprise endpoint.
# Pattern: recognize AUDD_EVERY chunks, then skip AUDD_SKIP chunks.
# Each recognized chunk is 12 seconds and is billed.
# Defaults cover about two hours at one sample every 36 seconds.
AUDD_API_TOKEN=
AUDD_LIMIT=200
AUDD_EVERY=1
AUDD_SKIP=2

# YouTube Data API v3 key, used only to read a video description
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
